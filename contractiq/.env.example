# =====================================================================
# ContractIQ — environment variables
# Copy to .env.local (never commit .env.local) and fill in real values.
# Server-only variables must NEVER be prefixed with NEXT_PUBLIC_.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Supabase → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → anon / publishable key (safe for the browser; RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase → Project Settings → API Keys → service_role / secret key (sb_secret_…). SERVER ONLY.
# Used for llm_usage logging and scheduled jobs. Must NOT be the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project ref (the subdomain of the URL) — used by `npm run db:types`
SUPABASE_PROJECT_REF=your-project-ref

# --- OpenAI -----------------------------------------------------------
# platform.openai.com → API keys. SERVER ONLY.
OPENAI_API_KEY=sk-proj-...
# Model used for extraction and chat (see docs/specs/key-term-extraction.md)
OPENAI_MODEL=gpt-4o

# --- App --------------------------------------------------------------
# Absolute base URL; used for auth email redirects. Local lab: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret used to hash user IDs before sending them to OpenAI. Generate: openssl rand -hex 32
USER_ID_HASH_SALT=change-me-to-a-long-random-string
# "live" (default) calls OpenAI; "fixture" returns canned responses for E2E tests
LLM_MODE=live
# Set to "true" to show the confidence-recalibration banner on results pages
NEXT_PUBLIC_CALIBRATION_WARNING=false

# --- Security limits ---------------------------------------------------------
# Max previous chat messages sent to the model per question (cost / context bound; max 198)
MAX_CHAT_HISTORY=100

# --- Alerts / operations (optional locally) -----------------------------
# Monthly OpenAI budget in USD; a Slack alert fires at 80 %
LLM_MONTHLY_BUDGET_USD=300
# Slack incoming-webhook URL for cost / correction-rate alerts (leave empty to disable)
SLACK_ALERT_WEBHOOK_URL=

# --- Integration tests only (.env.test.local) ----------------------------
# A separate Supabase project with the same schema and "Confirm email" off
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
